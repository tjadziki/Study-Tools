{
  "name": "term-command-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Term Command Deck \u2014 local study dashboard wired to real course materials",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test server/lib/*.test.js client/src/lib/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
